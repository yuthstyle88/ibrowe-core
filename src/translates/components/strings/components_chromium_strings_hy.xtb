<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="130631256467250065">Ձեր փոփոխություններն ուժի մեջ կմտնեն հաջորդ անգամ, երբ վերագործարկեք սարքը:</translation>
<translation id="6451924152958941455">Բացեք
          iBrowe-ի ընտրացանկը &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          և համոզվեք, որ ձեր կազմաձևի համար սահմանված է «առանց պրոքսի սերվերի» կամ «ուղիղ» պարամետրը։</translation>
<translation id="7999989146447764333">Խափանումների մասին հաղորդումը մատչելի չէ iBrowe-ում:</translation>
<translation id="1953231710324290369">Ցուցադրվող iBrowe էջն անվտանգ է</translation>
<translation id="907470742420136113">iBrowe-ը փորձում է փոխել վճարման եղանակների լրացման կարգավորումները։</translation>
<translation id="4847979153841887006">iBrowe-ի պատկերանշանը</translation>
<translation id="336808635693308470">iBrowe-ը փորձում է փոփոխել վճարման եղանակները։</translation>
<translation id="7932149101545999102">iBrowe-ը ստեղծվել է շնորհիվ <ph name="BEGIN_LINK_CHROMIUM"/>iBrowe<ph name="END_LINK_CHROMIUM"/> բաց կոդով նախագծի և այլ <ph name="BEGIN_LINK_OSS"/>բաց կոդով ծրագրակազմերի<ph name="END_LINK_OSS"/>:</translation>
<translation id="303960458633076466">Այս էջն արգելափակվել է iBrowe-ի կողմից</translation>
<translation id="2017237562285586622">Հրապատի կամ հակավիրուսային ծրագրի կարգավորումներում
       թույլատրեք iBrowe-ին միանալ ցանցին:</translation>
<translation id="4949828774841497663">Գնացեք Հավելվածներ &gt; Համակարգի կարգավորումներ &gt; Ցանց, ընտրեք
         ակտիվ ցանցը, սեղմեք Մանրամասներ... կոճակը և չեղարկեք ցանկացած                              պրոքսի սերվերի ընտրությունը։</translation>
<translation id="3269554930871094325">Բացեք
          iBrowe-ի ընտրացանկը &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Ցանց և ինտերնետ &gt; Պրոքսի սերվեր
          և անջատեք «Ավտոմատ որոշել կարգավորումները» պարամետրը։</translation>
<translation id="6159073403999048272">Այս էջերը, որոնք նախատեսված են iBrowe-ի մշակողների համար, չեն կարող պարբերաբար փորձարկվել կամ մշակվել։ Միացնելու համար անցեք <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> էջ, սեղմեք կոճակը՝ վրիպազերծման էջերը միացնելու համար, այնուհետև վերադարձեք այստեղ։</translation>
<translation id="2765022094254723779">iBrowe-ը նաև աշխատում է այլ <ph name="BEGIN_LINK_OSS"/>բաց կոդով ծրագրակազմի<ph name="END_LINK_OSS"/> շնորհիվ։</translation>
<translation id="9156965752763025780">Փոփոխություններն ուժի մեջ կմտնեն iBrowe-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="8828443087767259398">Զուգակցումը շարունակելու համար iBrowe-ին հասանելի դարձրեք Bluetooth-ը։ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">iBrowe-ը ստեղծվել է <ph name="BEGIN_LINK_CHROMIUM"/>iBrowe<ph name="END_LINK_CHROMIUM"/>-ի բաց կոդով նախագծի հիման վրա։</translation>
<translation id="4068928808254189629">Անցեք
          iBrowe ընտրացանկ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          և ապանշեք «<ph name="NO_PREFETCH_DESCRIPTION"/>»-ը:
          Եթե խնդիրը չվերանա, խորհուրդ ենք տալիս կրկին ընտրել այս տարբերակը՝
          արդյունավետությունը բարձրացնելու համար:</translation>
<translation id="4159376633403260073">Դուք դիտում եք iBrowe for Testing-ի անվտանգ էջ</translation>
<translation id="88187049159266777">iBrowe-ը ճիշտ չի փակվել:</translation>
</translationbundle>